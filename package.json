{
  "name": "encyklopedia",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Read-only, multilingual encyclopedia delivery surface for qualified Kristal publications",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node src/server.mjs",
    "check": "node --check src/server.mjs && node --check src/catalog.mjs && node --check src/research.mjs && node --check src/private-v11-preflight.mjs && node --check tools/private-v11-preflight.mjs && node --check public/app.js",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "v11:private-preflight": "node tools/private-v11-preflight.mjs",
    "harvest:sources": "node tools/dictionary-harvester/cli.mjs sources",
    "harvest:status": "node tools/dictionary-harvester/cli.mjs status",
    "harvest:test": "node --test tests/dictionary-harvester.test.mjs",
    "lexical:plan": "node tools/dictionary-harvester/cli.mjs index-plan",
    "lexical:index": "node tools/dictionary-harvester/cli.mjs index-run",
    "lexical:status": "node tools/dictionary-harvester/cli.mjs index-status",
    "lexical:repair": "node tools/dictionary-harvester/cli.mjs index-repair",
    "lexical:quality": "node tools/dictionary-harvester/cli.mjs quality-audit",
    "lexical:quality:diagnostic": "node tools/dictionary-harvester/cli.mjs quality-diagnostic",
    "lexical:dik:plan": "node tools/dictionary-harvester/cli.mjs dik-plan",
    "lexical:dik:stage": "node tools/dictionary-harvester/cli.mjs dik-stage",
    "lexical:dik:status": "node tools/dictionary-harvester/cli.mjs dik-status",
    "lexical:dik:verify": "node tools/dictionary-harvester/cli.mjs dik-verify",
    "lexical:dik:enrich:plan": "node tools/dictionary-harvester/cli.mjs dik-enrich-plan",
    "lexical:dik:enrich": "node tools/dictionary-harvester/cli.mjs dik-enrich-run",
    "lexical:dik:enrich:verify": "node tools/dictionary-harvester/cli.mjs dik-enrich-verify",
    "lexical:dik:qualify:plan": "node tools/dictionary-harvester/cli.mjs dik-qualify-plan",
    "lexical:dik:qualify": "node tools/dictionary-harvester/cli.mjs dik-qualify-run",
    "lexical:dik:qualify:verify": "node tools/dictionary-harvester/cli.mjs dik-qualify-verify"
  }
}
