# ============================================================
# EncyKlopedia - Smart Snapshot ignore
# Purpose: compact, code-first snapshot for AI review / coding.
#
# Keep:
#   - executable source / launchers / configs
#   - architecture docs / ADRs / READMEs
#   - schemas / tests / examples
#   - active seed material useful to understand contracts
#   - small provenance / source metadata
#
# Exclude:
#   - downloaded corpora and dumps
#   - SQLite / indexes / compression indexes
#   - ingest checkpoints / snapshots / handoffs
#   - working state / generated evidence
#   - generated media candidates
#   - duplicate source collections
#   - caches / environments / recovery / snapshots
# ============================================================

# ------------------------------------------------------------
# VCS / IDE / OS
# ------------------------------------------------------------
.git/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ------------------------------------------------------------
# Python / tooling caches
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ------------------------------------------------------------
# Environments / installed dependencies
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
site-packages/
node_modules/

# ------------------------------------------------------------
# Build / packaging output
# ------------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/

# ------------------------------------------------------------
# Logs / temp / diagnostics
# ------------------------------------------------------------
*.log
*.tmp
*.bak
*.old
*.orig
*.pid
*.lock.tmp
.cache/
cache/
logs/
log/
tmp/
temp/
diagnostics/
crash/

# ------------------------------------------------------------
# Secrets / machine-local configuration
# ------------------------------------------------------------
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key
*.pfx
*.p12
local.settings.json
settings.local.json
config.local.*
*.local.toml
*.local.yaml
*.local.yml
*.local.json

