{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interaction-kernel.dev/schemas/1.1/export-manifest.schema.json",
  "title": "IK ExportManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "profile",
    "producer",
    "snapshot_at",
    "subjects",
    "items",
    "integrity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "profile": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "instance": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "organization": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "world": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "release": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "snapshot_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "scope": {
      "type": [
        "object",
        "null"
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "ref",
          "digest"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 10000
    },
    "intended_use": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 100
    },
    "provenance": {
      "type": [
        "object",
        "null"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
        }
      }
    }
  }
}
