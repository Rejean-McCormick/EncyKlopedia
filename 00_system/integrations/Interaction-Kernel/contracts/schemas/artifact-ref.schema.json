{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interaction-kernel.dev/schemas/1.1/artifact-ref.schema.json",
  "title": "IK ArtifactRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "artifact_type",
    "artifact_id"
  ],
  "properties": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "instance": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "organization": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "world": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "release": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "integrity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
        }
      }
    },
    "locator": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "not": {
            "pattern": "(?:[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Aa][Pp][Ii](?:[_-]?[Kk][Ee][Yy]))=|://[^/@:]+:[^/@]+@"
          }
        }
      }
    },
    "content": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "contract_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "scope": {
      "type": [
        "object",
        "null"
      ]
    },
    "provenance": {
      "type": [
        "object",
        "null"
      ]
    },
    "access": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
