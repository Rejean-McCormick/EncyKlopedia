{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interaction-kernel.dev/schemas/1.1/envelope.schema.json",
  "title": "IK Interaction Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "class",
    "time",
    "profile",
    "source",
    "subject"
  ],
  "properties": {
    "specversion": {
      "const": "ik/1.1"
    },
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "class": {
      "enum": [
        "command",
        "query",
        "event"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "instance": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "organization": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "world": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "release": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "instance": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "organization": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "world": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "release": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "operation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "authority": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1000
              },
              "maxItems": 100
            },
            "context": {
              "type": "object"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "data_schema": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "data": {},
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "artifact-ref.schema.json"
      },
      "maxItems": 1000
    },
    "governance": {
      "type": [
        "object",
        "null"
      ]
    },
    "response": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "acceptance_receipt": {
          "type": "boolean"
        },
        "final_receipt": {
          "type": "boolean"
        },
        "outcome_events": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "trace": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "traceparent": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "tracestate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "evidence": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "extensions": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "class": {
            "enum": [
              "command",
              "query"
            ]
          }
        }
      },
      "then": {
        "required": [
          "target"
        ]
      }
    }
  ]
}
