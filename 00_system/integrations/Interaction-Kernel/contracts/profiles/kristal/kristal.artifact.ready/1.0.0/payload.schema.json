{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interaction-kernel.dev/profiles/kristal.artifact.ready/1.0.0/payload.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "build_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "stage": {
      "enum": [
        "working",
        "reference",
        "runtime-pack",
        "validation-report",
        "authority-recognition"
      ]
    }
  },
  "required": [
    "build_ref",
    "stage"
  ]
}
