{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interaction-kernel.dev/profiles/kristal.revision.request/1.0.0/payload.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "mapping_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "reason",
    "mapping_profile"
  ]
}
