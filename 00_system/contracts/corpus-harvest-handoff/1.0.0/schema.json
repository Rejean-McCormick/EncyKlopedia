{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encyklopedia.local/contracts/corpus-harvest-handoff/1.0.0/schema.json",
  "title": "EncyKlopedia Corpus Harvest Handoff 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "scope_key",
    "snapshot_id",
    "created_at",
    "kristal_contract_set",
    "referent_profile",
    "files",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "encyklopedia-daat-handoff/v4"
    },
    "contract": {
      "const": "encyklopedia.corpus-harvest-handoff/1.0.0"
    },
    "scope_key": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_semantics": {
      "type": "string"
    },
    "mapping_boundary": {
      "const": "Da'at"
    },
    "target": {
      "type": "string"
    },
    "kristal_contract_set": {
      "const": "5.0.0-rc.3"
    },
    "referent_profile": {
      "const": "kristal.referent-registry/1.0.0"
    },
    "kristal_contract_bundle_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "scope_config": {
      "type": "object"
    },
    "kristal_environment": {
      "type": "object"
    },
    "interaction_kernel": {
      "type": "object"
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^handoff-[0-9a-f]{20}$"
    }
  }
}
