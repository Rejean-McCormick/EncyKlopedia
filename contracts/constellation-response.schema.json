{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:konstellation:schema:constellation-response:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "context", "focus", "groupId", "center", "satellites", "limit", "totalCandidates", "truncated"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetRef", "registryRef", "readerPolicyRef", "executionProfileRef"],
      "properties": {
        "datasetRef": { "type": "string", "minLength": 1 },
        "registryRef": { "type": "string", "minLength": 1 },
        "readerPolicyRef": { "type": "string", "minLength": 1 },
        "executionProfileRef": { "type": "string", "minLength": 1 }
      }
    },
    "focus": { "$ref": "#/$defs/focus" },
    "groupId": { "type": ["string", "null"], "maxLength": 300 },
    "center": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 2200 },
        "kind": { "enum": ["entity", "source", "concept", "value", "group"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "satellites": {
      "type": "array",
      "minItems": 0,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "count", "target", "salience", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 2200 },
          "kind": { "enum": ["group", "entity", "source", "concept", "value"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 500 },
          "count": { "type": ["integer", "null"], "minimum": 0 },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["focus", "groupId"],
            "properties": {
              "focus": { "$ref": "#/$defs/focus" },
              "groupId": { "type": ["string", "null"], "maxLength": 300 }
            }
          },
          "salience": {
            "type": "object",
            "additionalProperties": false,
            "required": ["score", "base", "redundancy", "signals"],
            "properties": {
              "score": { "type": "number" },
              "base": { "type": "number" },
              "redundancy": { "type": "number", "minimum": 0, "maximum": 1 },
              "signals": {
                "type": "object",
                "additionalProperties": false,
                "required": ["assertions", "entities", "sources", "priority"],
                "properties": {
                  "assertions": { "type": "integer", "minimum": 0 },
                  "entities": { "type": "integer", "minimum": 0 },
                  "sources": { "type": "integer", "minimum": 0 },
                  "priority": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertionCount", "entityCount", "sourceCount"],
            "properties": {
              "assertionCount": { "type": "integer", "minimum": 0 },
              "entityCount": { "type": "integer", "minimum": 0 },
              "sourceCount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "limit": { "type": "integer", "minimum": 3, "maximum": 25 },
    "totalCandidates": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" }
  },
  "$defs": {
    "focus": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "entity" },
            "id": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "source" },
            "id": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "predicate", "key"],
          "properties": {
            "kind": { "const": "qualifier" },
            "predicate": { "type": "string", "minLength": 1, "maxLength": 500 },
            "key": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "relation", "key"],
          "properties": {
            "kind": { "const": "relation-value" },
            "relation": { "type": "string", "minLength": 1, "maxLength": 500 },
            "key": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        }
      ]
    }
  }
}
