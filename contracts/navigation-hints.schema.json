{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:konstellation:schema:navigation-hints:1.0",
  "title":"Konstellation navigationHints v1.0",
  "type":"object","additionalProperties":false,"required":["schemaVersion"],
  "properties":{
    "schemaVersion":{"enum":["0.1","1.0"]},
    "affordances":{"$ref":"#/$defs/affordanceMap"},
    "relationAffordances":{"$ref":"#/$defs/relationAffordanceMap"},
    "preferredRecipes":{"type":"array","items":{"$ref":"#/$defs/recipeId"},"uniqueItems":true,"maxItems":18},
    "recipeLabels":{"type":"object","propertyNames":{"$ref":"#/$defs/recipeId"},"additionalProperties":{"type":"string","minLength":1,"maxLength":80}},
    "entityTypes":{"type":"object","maxProperties":200,"additionalProperties":{"$ref":"#/$defs/profile"}},
    "capabilities":{"$ref":"#/$defs/affordanceMap","deprecated":true},
    "relationCapabilities":{"$ref":"#/$defs/relationAffordanceMap","deprecated":true}
  },
  "$defs":{
    "affordanceId":{"enum":["network","temporal","hierarchy","dependency","sequence","stateMachine","conditionalTransition","causal","signedCausal","cycle","spatial","multiScale","multiplex","proof","argumentation","multidimensional","quantitative","evidential","provenance","versioned","eventStream","resourceAllocation","classification","conflict","succession","lineage","actionability","stateful"]},
    "affordanceValue":{"oneOf":[{"type":"boolean"},{"type":"number","minimum":0,"maximum":1},{"type":"object","additionalProperties":false,"required":["score"],"properties":{"score":{"type":"number","minimum":0,"maximum":1},"reason":{"type":"string","minLength":1,"maxLength":240}}}]},
    "affordanceMap":{"type":"object","propertyNames":{"$ref":"#/$defs/affordanceId"},"additionalProperties":{"$ref":"#/$defs/affordanceValue"},"maxProperties":28},
    "relationAffordanceMap":{"type":"object","maxProperties":2000,"additionalProperties":{"type":"array","items":{"$ref":"#/$defs/affordanceId"},"uniqueItems":true,"maxItems":12}},
    "recipeId":{"enum":["catalogue","constellation","timeline","hierarchy","dependencies","path","feedback","proofs","arguments","dimensions","states","evolution","divergences","traceability","action-context","multiscale","spatial","table"]},
    "profile":{"type":"object","additionalProperties":false,"properties":{"affordances":{"$ref":"#/$defs/affordanceMap"},"relationAffordances":{"$ref":"#/$defs/relationAffordanceMap"},"preferredRecipes":{"type":"array","items":{"$ref":"#/$defs/recipeId"},"uniqueItems":true,"maxItems":18},"recipeLabels":{"type":"object","propertyNames":{"$ref":"#/$defs/recipeId"},"additionalProperties":{"type":"string","minLength":1,"maxLength":80}},"capabilities":{"$ref":"#/$defs/affordanceMap","deprecated":true},"relationCapabilities":{"$ref":"#/$defs/relationAffordanceMap","deprecated":true}}}
  }
}
