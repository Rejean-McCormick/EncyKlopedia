{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:konstellation:schema:navigation-projection:1.0",
  "title": "Konstellation Navigation Projection DTO v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionKind",
    "recipeId",
    "rendererId",
    "derived",
    "truncated",
    "explanation",
    "nextCursor",
    "totalCandidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "projectionKind": {
      "enum": [
        "timeline-lineage",
        "tree",
        "dag",
        "flow",
        "causal-feedback",
        "matrix",
        "state-flow",
        "traceability",
        "multiscale",
        "spatial"
      ]
    },
    "recipeId": {
      "type": "string",
      "minLength": 1
    },
    "rendererId": {
      "type": "string",
      "minLength": 1
    },
    "derived": {
      "const": true
    },
    "truncated": {
      "type": "boolean"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "totalCandidates": {
      "type": "integer",
      "minimum": 0
    },
    "explanation": {
      "$ref": "#/$defs/explanation"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineItem"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineLink"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "roots": {
      "$ref": "#/$defs/idList"
    },
    "terminals": {
      "$ref": "#/$defs/idList"
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "starts": {
      "$ref": "#/$defs/idList"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/matrixColumn"
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/matrixCell"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateRecord"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "memberships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/membership"
      }
    },
    "crossLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spatialPoint"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spatialPlace"
      }
    },
    "acyclic": {
      "type": "boolean"
    },
    "semantics": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "entity",
            "assertion",
            "source"
          ]
        },
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "assertionRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "relationIds"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "relationIds": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "relationId": {
          "type": "string"
        },
        "relationLabel": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "sign": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRefs": {
          "$ref": "#/$defs/idList"
        },
        "recordRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "valuations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valuation"
          }
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        },
        "conflictsWith": {
          "$ref": "#/$defs/idList"
        },
        "supersedes": {
          "$ref": "#/$defs/idList"
        },
        "actionability": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/actionability"
            }
          ]
        },
        "lineage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/lineageSummary"
            }
          ]
        }
      }
    },
    "timelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entity",
        "relationId",
        "relationLabel",
        "assertionRef"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "$ref": "#/$defs/node"
        },
        "relationId": {
          "type": "string",
          "minLength": 1
        },
        "relationLabel": {
          "type": "string"
        },
        "start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "end": {
          "type": [
            "integer",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "temporalLabel": {
          "type": "string"
        },
        "assertionRef": {
          "type": "string",
          "minLength": 1
        },
        "derivedFrom": {
          "type": "string"
        },
        "via": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entityId",
            "relationId",
            "relationLabel"
          ],
          "properties": {
            "entityId": {
              "type": "string",
              "minLength": 1
            },
            "relationId": {
              "type": "string",
              "minLength": 1
            },
            "relationLabel": {
              "type": "string"
            }
          }
        }
      }
    },
    "timelineLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "supersedes",
            "lineage"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "assertionRef": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/lineageSummary"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "supersedes"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "lineage"
              }
            }
          },
          "then": {
            "required": [
              "assertionRef",
              "value"
            ]
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "state"
          ],
          "properties": {
            "kind": {
              "const": "valuation"
            },
            "dimension": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "known",
                "unknown",
                "not_applicable",
                "indeterminate",
                "not_measured"
              ]
            },
            "value": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "known"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "required": [
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "unknown",
                      "not_applicable",
                      "indeterminate",
                      "not_measured"
                    ]
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "value"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "axis",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "coordinate"
            },
            "axis": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        }
      ]
    },
    "transition": {
      "allOf": [
        {
          "$ref": "#/$defs/edge"
        },
        {
          "type": "object",
          "required": [
            "conditional",
            "conditions"
          ],
          "properties": {
            "conditional": {
              "type": "boolean"
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        }
      ]
    },
    "matrixColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "matrixCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "dimensionId",
        "value",
        "assertionRef"
      ],
      "properties": {
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "dimensionId": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "assertionRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionRef",
        "entity",
        "relationId",
        "relationLabel",
        "status",
        "valuations",
        "coordinates",
        "sourceRefs"
      ],
      "properties": {
        "assertionRef": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "$ref": "#/$defs/node"
        },
        "relationId": {
          "type": "string",
          "minLength": 1
        },
        "relationLabel": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "actionability": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/actionability"
            }
          ]
        },
        "valuations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valuation"
          }
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        },
        "sourceRefs": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "axis",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "axis": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "layerId",
        "assertionRef"
      ],
      "properties": {
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "assertionRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spatialPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "lat",
        "long",
        "label"
      ],
      "properties": {
        "entity": {
          "$ref": "#/$defs/node"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "long": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "label": {
          "type": "string"
        }
      }
    },
    "spatialPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "place",
        "relationId",
        "relationLabel",
        "assertionRef"
      ],
      "properties": {
        "entity": {
          "$ref": "#/$defs/node"
        },
        "place": {
          "$ref": "#/$defs/node"
        },
        "relationId": {
          "type": "string",
          "minLength": 1
        },
        "relationLabel": {
          "type": "string"
        },
        "assertionRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "value"
      ],
      "properties": {
        "axis": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "value_semantics",
        "value_state"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "value_semantics": {
          "enum": [
            "boolean",
            "categorical",
            "set",
            "ordinal",
            "scalar",
            "interval",
            "probability",
            "distribution",
            "vector",
            "partial_order",
            "state",
            "temporal"
          ]
        },
        "value_state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "indeterminate",
            "not_measured"
          ]
        },
        "value": {},
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              }
            },
            "required": [
              "value_state"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "enum": [
                  "unknown",
                  "not_applicable",
                  "indeterminate",
                  "not_measured"
                ]
              }
            },
            "required": [
              "value_state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "actionability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "automatic",
            "human_review",
            "human_decision",
            "manual",
            "prohibited",
            "insufficient_information",
            "not_applicable"
          ]
        },
        "requires_human_validation": {
          "type": "boolean"
        }
      }
    },
    "lineageSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "present": {
          "const": true
        },
        "isFork": {
          "type": "boolean"
        },
        "recognized": {
          "type": "boolean"
        },
        "sourceAssertions": {
          "$ref": "#/$defs/idList"
        },
        "transformTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "present"
          ]
        },
        {
          "required": [
            "isFork"
          ]
        },
        {
          "required": [
            "recognized"
          ]
        },
        {
          "required": [
            "sourceAssertions"
          ]
        },
        {
          "required": [
            "transformTypes"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "projectionKind": {
            "const": "timeline-lineage"
          }
        },
        "required": [
          "projectionKind"
        ]
      },
      "then": {
        "required": [
          "items",
          "links"
        ],
        "properties": {
          "rendererId": {
            "const": "timeline-lineage"
          },
          "recipeId": {
            "enum": [
              "timeline",
              "evolution"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projectionKind": {
            "const": "tree"
          }
        },
        "required": [
          "projectionKind"
        ]
      },
      "then": {
        "required": [
          "nodes",
          "edges",
          "roots"
        ],
        "properties": {
          "rendererId": {
            "const": "tree"
          },
          "recipeId": {
            "enum": [
              "hierarchy"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projectionKind": {
            "const": "dag"
          }
        },
        "required": [
          "projectionKind"
        ]
      },
      "then": {
        "required": [
          "nodes",
          "edges",
          "roots",
          "terminals",
          "acyclic",
          "cycles"
        ],
        "properties": {
          "rendererId": {
            "const": "dag-proof"
          },
          "recipeId": {
            "enum": [
              "dependencies",
              "proofs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projectionKind": {
            "const": "flow"
          }
        },
        "required": [
          "projectionKind"
        ]
      },
      "then": {
        "required": [
          "nodes",
          "transitions",
          "starts",
          "terminals"
        ],
        "properties": {
          "rendererId": {
            "const": "flow-path"
          },
          "recipeId": {
            "enum": [
              "path"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projectionKind": {
            "const": "causal-feedback"
          }
        },
        "required": [
          "projectionKind"
        ]
      },
      "then": {
        "required": [
          "nodes",
          "edges",
          "cycles"
        ],
        "properties": {
          "rendererId": {
            "const": "causal-feedback"
          },
          "recipeId": {
            "enum": [
              "feedback"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projectionKind": {
            "const": "matrix"
          }
        },
        "required": [
          "projectionKind"
        ]
      },
      "then": {
        "required": [
          "rows",
          "columns",
          "cells"
        ],
        "properties": {
          "rendererId": {
            "const": "matrix-profile"
          },
          "recipeId": {
            "enum": [
              "dimensions"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projectionKind": {
            "const": "state-flow"
          }
        },
        "required": [
          "projectionKind"
        ]
      },
      "then": {
        "required": [
          "records",
          "transitions",
          "semantics"
        ],
        "properties": {
          "rendererId": {
            "const": "state-flow"
          },
          "recipeId": {
            "enum": [
              "states",
              "action-context"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projectionKind": {
