{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:konstellation:schema:navigation-plan:1.0",
  "title": "Konstellation NavigationPlan v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","mode","derived","semantics","scope","entityType","entityTypeLabel","lensRef","lensLabel","primaryRecipeId","views","actions","profile"],
  "properties": {
    "schemaVersion": {"const":"1.0"},
    "mode": {"const":"adaptive"},
    "derived": {"const":true},
    "semantics": {"const":"navigation-affordances-not-kristal-authority"},
    "scope": {
      "type":"object","additionalProperties":false,"required":["kind","entityType"],
      "properties":{"kind":{"enum":["selection","focus"]},"entityType":{"type":"string","minLength":1},"focusEntityId":{"type":"string","minLength":1}}
    },
    "entityType":{"type":"string","minLength":1}, "entityTypeLabel":{"type":"string"},
    "lensRef":{"type":"string","minLength":1}, "lensLabel":{"type":"string"},
    "primaryRecipeId":{"$ref":"#/$defs/recipeId"},
    "views":{"type":"array","minItems":1,"maxItems":10,"items":{"$ref":"#/$defs/view"}},
    "actions":{"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","label","affordance"],"properties":{"id":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},"affordance":{"$ref":"#/$defs/affordanceId"},"recipeId":{"$ref":"#/$defs/recipeId"}}}},
    "profile":{"type":"object","additionalProperties":false,"required":["schemaVersion","scope","entityType","affordances"],"properties":{"schemaVersion":{"const":"1.0"},"scope":{"enum":["pack","entity-type","focus","result-set"]},"entityType":{"type":["string","null"]},"affordances":{"$ref":"#/$defs/affordanceProfile"}}}
  },
  "$defs": {
    "recipeId":{"enum":["catalogue","constellation","timeline","hierarchy","dependencies","path","feedback","proofs","arguments","dimensions","states","evolution","divergences","traceability","action-context","multiscale","spatial","table"]},
    "rendererId":{"enum":["list","table","constellation","timeline-lineage","tree","dag-proof","flow-path","causal-feedback","matrix-profile","state-flow","traceability","multiscale-layer","spatial"]},
    "affordanceId":{"enum":["network","temporal","hierarchy","dependency","sequence","stateMachine","conditionalTransition","causal","signedCausal","cycle","spatial","multiScale","multiplex","proof","argumentation","multidimensional","quantitative","evidential","provenance","versioned","eventStream","resourceAllocation","classification","conflict","succession","lineage","actionability","stateful"]},
    "affordance":{"type":"object","additionalProperties":false,"required":["score","evidence"],"properties":{"score":{"type":"number","minimum":0,"maximum":1},"evidence":{"type":"array","maxItems":8,"items":{"type":"string","maxLength":300}}}},
    "affordanceProfile":{"type":"object","propertyNames":{"$ref":"#/$defs/affordanceId"},"additionalProperties":{"$ref":"#/$defs/affordance"},"maxProperties":28},
    "view":{"type":"object","additionalProperties":false,"required":["id","label","rendererId","icon","score","description","reason","relationIds"],"properties":{"id":{"$ref":"#/$defs/recipeId"},"label":{"type":"string","minLength":1},"rendererId":{"$ref":"#/$defs/rendererId"},"icon":{"type":"string","minLength":1,"maxLength":8},"score":{"type":"number","minimum":0,"maximum":1},"description":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1,"maxLength":900},"relationIds":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1}}}}
  }
}
