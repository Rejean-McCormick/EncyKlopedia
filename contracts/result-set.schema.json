{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:konstellation:schema:result-set:0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "context",
    "queryIdentity",
    "evaluation",
    "rows",
    "assertions",
    "nextCursor",
    "total"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetRef",
        "registryRef",
        "readerPolicyRef",
        "executionProfileRef"
      ],
      "properties": {
        "datasetRef": {
          "type": "string",
          "minLength": 1
        },
        "registryRef": {
          "type": "string",
          "minLength": 1
        },
        "readerPolicyRef": {
          "type": "string",
          "minLength": 1
        },
        "executionProfileRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "queryIdentity": {
      "type": "string",
      "minLength": 1
    },
    "evaluation": {
      "const": "complete"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entityId",
          "witnesses",
          "witnessesComplete"
        ],
        "properties": {
          "entityId": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
          },
          "witnesses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionPath",
                "kind",
                "assertionRefs",
                "sourceRefs"
              ],
              "properties": {
                "criterionPath": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "assertion",
                    "absence_in_view",
                    "derivation"
                  ]
                },
                "assertionRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
                  },
                  "minItems": 0,
                  "maxItems": 100,
                  "uniqueItems": true
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0,
                  "maxItems": 100,
                  "uniqueItems": true
                },
                "ruleRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "derivation"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "ruleRef"
                    ],
                    "properties": {
                      "assertionRefs": {
                        "minItems": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "assertion"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "assertionRefs": {
                        "minItems": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "absence_in_view"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "assertionRefs": {
                        "maxItems": 0
                      },
                      "sourceRefs": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              ]
            },
            "minItems": 0
          },
          "witnessesComplete": {
            "type": "boolean"
          }
        }
      },
      "minItems": 0,
      "maxItems": 100
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertionRef",
          "upstreamContractRef",
          "payload"
        ],
        "properties": {
          "assertionRef": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
          },
          "upstreamContractRef": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "minItems": 0
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "not_computed"
            }
          }
        }
      ]
    }
  }
}
