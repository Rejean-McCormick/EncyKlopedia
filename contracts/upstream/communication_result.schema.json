{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantik-architect:schema:communication-result:1.0",
  "title": "CommunicationResult v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "blocks",
    "coverage",
    "runtime",
    "deterministic_result_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "language": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "plain_text": {
      "type": "string"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "block_ids",
          "realization_unit_ids"
        ],
        "properties": {
          "obligation_id": {
            "type": "string"
          },
          "block_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "realization_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sa_version",
        "runtime_set_id",
        "sa_gf_contract_version"
      ],
      "properties": {
        "sa_version": {
          "type": "string"
        },
        "runtime_set_id": {
          "type": "string"
        },
        "sa_gf_contract_version": {
          "type": "string"
        },
        "capability_profile": {
          "type": "string"
        }
      }
    },
    "deterministic_result_id": {
      "type": "string",
      "minLength": 1
    },
    "operational": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_id",
            "kind",
            "text",
            "obligation_ids"
          ],
          "properties": {
            "block_id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "utterance",
                "question",
                "notice",
                "heading"
              ]
            },
            "text": {
              "type": "string"
            },
            "obligation_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_id",
            "kind",
            "items",
            "obligation_ids"
          ],
          "properties": {
            "block_id": {
              "type": "string"
            },
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "item_id",
                  "text",
                  "obligation_ids"
                ],
                "properties": {
                  "item_id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "obligation_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "obligation_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_id",
            "kind",
            "label",
            "value",
            "obligation_ids"
          ],
          "properties": {
            "block_id": {
              "type": "string"
            },
            "kind": {
              "const": "label_value"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "obligation_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
