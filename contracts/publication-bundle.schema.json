{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:encyklopedia:publication-bundle:0.1.0",
  "title": "EncyKlopedia synthetic demo publication envelope (not a Kristal normative contract)",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "qualified", "publication_id", "framework_target", "source_view_profile", "locales", "articles"],
  "properties": {
    "profile": {"const": "encyklopedia.publication-bundle/0.1.0"},
    "mode": {"const": "synthetic-demo"},
    "qualified": {"const": false},
    "publication_id": {"type": "string", "pattern": "^demo-"},
    "framework_target": {"const": "11.0.0-draft.4"},
    "source_view_profile": {"const": "kristal.integration.read-view/v11.0-draft.1"},
    "locales": {"type":"array", "minItems":1, "maxItems":20, "uniqueItems":true, "items":{"type":"string"}},
    "articles": {
      "type":"array","minItems":1,"maxItems":200,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["id","slug","semantic_id","localized","source_refs"],
        "properties": {
          "id":{"type":"string","pattern":"^demo:"},
          "slug":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},
          "semantic_id":{"type":"string","pattern":"^demo:"},
          "source_refs":{"type":"array","items":{"type":"object","required":["id","label","url"],"properties":{"id":{"type":"string","pattern":"^demo:"},"label":{"type":"string"},"url":{"type":"null"}},"additionalProperties":false}},
          "localized":{"type":"object","additionalProperties":{"type":"object","required":["title","summary","sections"],"properties":{"title":{"type":"string"},"summary":{"type":"string"},"sections":{"type":"array","items":{"type":"object","required":["heading","body"],"properties":{"heading":{"type":"string"},"body":{"type":"string"}},"additionalProperties":false}}},"additionalProperties":false}}
        }
      }
    }
  }
}
